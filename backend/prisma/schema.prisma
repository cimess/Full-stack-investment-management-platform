datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["tracing"]
}

enum Roles {
  ADMIN
  USER
  MANAGER
}

enum TransactionType {
  BUY
  SELL
}

enum Status {
  SUCCESS
  PENDING
  REJECTED
}

enum NotificationType {
  TRADE
  MESSAGE
  SYSTEM
}

model User {
  id         String   @id @default(cuid())
  googleId   String?  @unique
  email      String   @unique
  username   String
  password   String?
  fullname   String
  roles      Roles    @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  manager_id String?
  restricted Boolean  @default(false)
  avatar     String?
  termsAccepted Boolean @default(false)

  // Email Verification Fields
  isVerified               Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?

  disabled Boolean @default(false)


  settings      UserSettings?  @relation("userSettings")
  notifications Notification[] @relation("user_notifications")

  portfolio        Portfolio[]       @relation("portfolio")
  refreshToken     RefreshToken[]    @relation("refreshToken")
  manager          Manager?          @relation("manager")
  client_manager   Manager?          @relation("managed_by", fields: [manager_id], references: [id])
  to_admin         Admin?            @relation("admin")
  add_admin        Approved_Admin?   @relation("add_admin")
  Approved_Manager Approved_Manager? @relation("Approved_Manager")

  reportsSubmitted SystemReport[] @relation("reporter")

  // --- Analytics Fields ---
  analyticsConsent Boolean        @default(true)
  sessions         UserSession[]  @relation("user_sessions")
  pageVisits       PageVisit[]    @relation("user_page_visits")
  featureEvents    FeatureEvent[] @relation("user_feature_events")
  userFeedback     UserFeedback[] @relation("user_feedback")
}

model StockTable {
  id                        String          @id @default(cuid())
  symbol                    String          @unique
  company                   String
  price                     Decimal         @db.Decimal(10, 2)
  changePercent             Decimal?        @db.Decimal(8, 4)
  marketCap                 BigInt?
  volume                    BigInt?
  peRatio                   Decimal?        @db.Decimal(10, 2)
  dividendYield             Decimal?        @db.Decimal(8, 4)
  fiftyTwoWeekLow           Decimal?        @db.Decimal(10, 2)
  fiftyTwoWeekHigh          Decimal?        @db.Decimal(10, 2)
  fiftyTwoWeekChangePercent Decimal?        @db.Decimal(8, 4)
  dayHigh                   Decimal?        @db.Decimal(10, 2)
  dayLow                    Decimal?        @db.Decimal(10, 2)
  ytdReturn                 Decimal?        @db.Decimal(8, 4)
  change                    Decimal?        @db.Decimal(8, 2)
  currency                  String          @default("USD")
  exchange                  String?
  assetType                 String          @default("STOCK")
  open                      Decimal?        @db.Decimal(10, 2)
  previousClose             Decimal?        @db.Decimal(10, 2)
  bid                       Decimal?        @db.Decimal(10, 2)
  ask                       Decimal?        @db.Decimal(10, 2)
  bidSize                   Int?
  askSize                   Int?
  beta                      Decimal?        @db.Decimal(8, 4)
  eps                       Decimal?        @db.Decimal(10, 4)
  // for stocks
  industry      String?
  sector        String?
  hq            String?
  ceo           String?
  about         String?   @db.Text
  website       String?
  // for crypto
  circulatingSupply  BigInt?
  maxSupply          BigInt?
  marketCapRank      Int?
  startDate          DateTime?
  lastUpdated        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  investment         Investment[]    @relation("stock")
  transaction        Transaction[]   @relation("stockTransaction")
  trade_request      Trade_request[] @relation("trade_request")

    // --- Institutional Metrics (Updated Daily) ---
  forwardPE         Decimal?  @db.Decimal(10, 4)
  priceToBook       Decimal?  @db.Decimal(10, 4)
  priceToSales      Decimal?  @db.Decimal(10, 4)
  enterpriseValue   BigInt?   
  ebitda            BigInt?  
  returnOnAssets    Decimal?  @db.Decimal(10, 4)
  freeCashflow      BigInt? 

  // Storage for 4-year trends (Revenue, Net Income, etc.)
  historicalAnalytics Json?

  // Profitability
  grossMargin       Decimal?  @db.Decimal(10, 4)
  operatingMargin   Decimal?  @db.Decimal(10, 4)
  profitMargin      Decimal?  @db.Decimal(10, 4)
  returnOnEquity    Decimal?  @db.Decimal(10, 4)
  
  // Health
  currentRatio      Decimal?  @db.Decimal(10, 4)
  debtToEquity      Decimal?  @db.Decimal(10, 4)


  // fundamentals
  revenue           BigInt?     // Using BigInt because Apple's revenue is 383 Billion!
  totalDebt         BigInt?
  totalCash         BigInt?
  sharesOutstanding BigInt?

  @@index([marketCap(sort: Desc)])
  @@index([changePercent(sort: Desc)])
  @@index([lastUpdated(sort: Desc)])
}

model Portfolio {
  id            String          @id @default(cuid())
  user          User            @relation("portfolio", fields: [user_id], references: [id])
  user_id       String
  investment    Investment[]    @relation("portfolio")
  transaction   Transaction[]   @relation("transaction")
  trade_request Trade_request[] @relation("trade_request")
}

model Investment {
  id           String     @id @default(cuid())
  portfolio    Portfolio  @relation("portfolio", fields: [portfolio_id], references: [id])
  portfolio_id String
  stock        StockTable @relation("stock", fields: [stock_id], references: [id])
  stock_id     String
  quantity     Int
  avgPrice     Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([portfolio_id, stock_id])
}

model Transaction {
  id           String          @id @default(cuid())
  portfolio    Portfolio       @relation("transaction", fields: [portfolio_id], references: [id])
  portfolio_id String
  stock        StockTable      @relation("stockTransaction", fields: [stock_id], references: [id])
  stock_id     String
  quantity     Int
  price        Decimal         @db.Decimal(10, 2)
  type         TransactionType
  createdAt    DateTime        @default(now())

  @@index([createdAt(sort: Desc)])
}

model Trade_request {
  id           String          @id @default(cuid())
  portfolio    Portfolio       @relation("trade_request", fields: [portfolio_id], references: [id])
  portfolio_id String
  stock        StockTable      @relation("trade_request", fields: [stock_id], references: [id])
  stock_id     String
  quantity     Int
  status       Status          @default(PENDING)
  type         TransactionType
  approved     Manager?        @relation("approvedBy", fields: [approved_by], references: [id])
  approved_by  String?
  response     String?
  createdAt    DateTime        @default(now())
}

model RefreshToken {
  id    String @id @default(cuid())
  token String @unique
  user  User   @relation("refreshToken", fields: [user_id], references: [id], onDelete: Cascade)

  user_id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manager {
  id         String @id @default(cuid())
  user       User   @relation("manager", fields: [manager_id], references: [id])
  manager_id String @unique

  managed_by    User[] @relation("managed_by")
  approval_code String @unique

  client_id    String?
  manager_slot Int     @default(1)

  // Profile fields — all optional, UI falls back to defaults if not set
  bio              String?
  title            String?
  specialization   String?
  years_experience Int?
  success_rate     Int?
  contact_email    String?
  availability     String?
  linkedin_url     String?
  aum_managed      BigInt?

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  approvedBy Trade_request[] @relation("approvedBy")
}

model Admin {
  id                 String             @id @default(cuid())
  user               User               @relation("admin", fields: [user_id], references: [id])
  user_id            String             @unique
  super_admin_access String?
  super_admin        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  admin_id           Approved_Manager[] @relation("admin_id")
  super_admin_id     Approved_Admin[]   @relation("super_admin_id")
}

model Approved_Manager {
  id            String   @id @default(cuid())
  approval_code String   @unique
  manager       User     @relation("Approved_Manager", fields: [user_id], references: [id])
  user_id       String   @unique
  admin         Admin    @relation("admin_id", fields: [admin_id], references: [id])
  admin_id      String
  manager_slot  Int      @default(0)
  is_used       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Approved_Admin {
  id            String   @id @default(cuid())
  approval_code String   @unique
  admin         User?    @relation("add_admin", fields: [admin_id], references: [id])
  admin_id      String?  @unique
  superAdmin    Admin    @relation("super_admin_id", fields: [superAdmin_id], references: [id])
  superAdmin_id String
  is_used       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserSettings {
  id                 String   @id @default(cuid())
  user               User     @relation("userSettings", fields: [user_id], references: [id], onDelete: Cascade)
  user_id            String   @unique
  tradeNotifications Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  theme              String   @default("system")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation("user_notifications", fields: [user_id], references: [id], onDelete: Cascade)
  user_id   String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([user_id, read])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum ReportType {
  BUG
  FRAUD
  SERVICE
  OTHER
}

model SystemReport {
  id          String     @id @default(cuid())
  reporter    User       @relation("reporter", fields: [reporterId], references: [id])
  reporterId  String
  targetId    String?    // ID of reported manager or asset
  type        ReportType @default(OTHER)
  subject     String
  description String     @db.Text
  status      Status     @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([reporterId])
  @@index([status])
}


model UserSession {
  id            String         @id @default(cuid())
  user          User           @relation("user_sessions", fields: [userId], references: [id])
  userId        String
  sessionToken  String         @unique
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  ipCountry     String?
  deviceType    String?        // desktop, mobile, tablet
  isNewUser     Boolean        @default(false)
  
  pageVisits    PageVisit[]
  featureEvents FeatureEvent[]

  @@index([userId])
  @@index([startedAt])
}

model PageVisit {
  id            String       @id @default(cuid())
  session       UserSession  @relation(fields: [sessionId], references: [id])
  sessionId     String
  user          User         @relation("user_page_visits", fields: [userId], references: [id])
  userId        String
  pageRoute     String
  enteredAt     DateTime     @default(now())
  exitedAt      DateTime?
  timeSpentMs   Int?

  @@index([userId])
  @@index([pageRoute])
  @@index([enteredAt])
}

model FeatureEvent {
  id            String       @id @default(cuid())
  session       UserSession? @relation(fields: [sessionId], references: [id])
  sessionId     String?
  user          User         @relation("user_feature_events", fields: [userId], references: [id])
  userId        String
  eventName     String
  eventMetadata Json?
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([eventName])
  @@index([createdAt])
}

model UserFeedback {
  id              String   @id @default(cuid())
  user            User     @relation("user_feedback", fields: [userId], references: [id])
  userId          String
  triggerContext  String
  questionAsked   String
  userResponse    String?  // Text response
  score           Int?     // NPS or 1-5 score
  submittedAt     DateTime @default(now())

  @@index([userId])
  @@index([triggerContext])
}
